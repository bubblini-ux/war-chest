# Environment Configuration Template
# Copy to .env for local development. NEVER commit .env or real credentials to Git.
# See Compliance/Confidentiality Standard.md and Website/Tech and Payments.md.

# Site Configuration
PUBLIC_SITE_URL=https://example.com
SITE_ENV=development

# Enquiry Form Provider (must have written approval per Compliance/Platform Restrictions.md)
ENQUIRY_FORM_ENDPOINT=
ENQUIRY_NOTIFICATION_EMAIL=

# Email / Newsletter Service (confirm firearm policy before configuring)
EMAIL_PROVIDER_API_KEY=
EMAIL_LIST_ID=

# Firearms-Friendly Payment / Invoice Integration (optional; enquiry-first at launch)
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
